<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Nur für den einmaligen Modell-Download (und Update-Prüfung) von GitHub; Dokumente und Chats verlassen das Gerät nie -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Fokus-Timer: Erinnerung zum Phasenende (genau, wenn erlaubt) und Wiederherstellung nach dem Neustart -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".LernsystemApp"
        android:allowBackup="false"
        android:label="Lernsystem"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <!-- LiteRT-LM: GPU-Backend braucht diese nativen Bibliotheken explizit -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
        <receiver android:name=".pomodoro.PomodoroAlarmReceiver" android:exported="false" />
        <receiver android:name=".pomodoro.PomodoroActionReceiver" android:exported="false" />
        <receiver android:name=".pomodoro.PomodoroBootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
